{
  "proto": "HBCE-REGISTRY-v1",
  "kind": "IPR_PUBLIC_REGISTRY",
  "policy": [
    "HASH_ONLY",
    "APPEND_ONLY",
    "FAIL_CLOSED",
    "UE_FIRST",
    "AUDIT_FIRST",
    "GDPR_MIN",
    "NO_PUBLIC_DATA_CUSTODY"
  ],
  "description": "Registro pubblico append-only. Pubblica solo prove minimizzate (name|nickname + hash + timestamp). Nessuna custodia pubblica di dati personali. Verifica deterministica: se non matcha -> INVALID (fail-closed).",

  "schema": {
    "entry_required": ["payload_sha256", "timestamp"],
    "entry_public_identity": ["name"],
    "entry_legacy_allowed": ["nickname"],
    "entry_optional": ["entity_type", "status"],

    "event_record_types": ["STATUS_UPDATE"],
    "event_required": ["record_type", "ref_payload_sha256", "status", "timestamp"],
    "event_optional": ["note"],

    "constraints": {
      "payload_sha256": "64-hex sha256",
      "ref_payload_sha256": "64-hex sha256",
      "timestamp": "ISO 8601",
      "name": "public display name (Nome Cognome or approved abbreviated form)",
      "status": "ACTIVE|SUPERSEDED|REVOKED"
    },

    "compatibility": "UI renders entry.name if present else entry.nickname (legacy). Matching uses payload_sha256 only. STATUS_UPDATE is append-only and may change effective status of a referenced hash in UI."
  },

  "entries": [
