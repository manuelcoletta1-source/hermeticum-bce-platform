  ],
  "rules": {
    "public_data": "HASH_ONLY",
    "write_mode": "MANUAL_APPEND_ONLY",
    "verification": "DETERMINISTIC_SHA256_MATCH",
    "failure_mode": "FAIL_CLOSED",
    "empty_entries": "NO_PUBLIC_PROOF",
    "private_evidence_policy": "PRIVATE_EVIDENCE_OUTSIDE_PUBLIC_REGISTRY",
    "sensitive_preimage_policy": "NO_RAW_PERSONAL_IDENTIFIER_HASHES_IN_PUBLIC_REGISTRY"
  },
  "privacy_note": "This public IPR registry must not store private identity evidence, identity documents, raw personal identifiers, credentials, secrets, private keys, production logs, or sensitive operational payloads. Public IPR records should be represented only through minimized metadata and hash-only public proof commitments.",
  "created_at": "2026-02-07T00:00:00.000Z",
  "last_update": "2026-05-06T00:00:00.000Z",
  "registry_prev_hash": "",
  "empty_registry_interpretation": "An empty entries array means no public IPR proof entries are currently available in this registry file. It does not certify validity, authorization, identity status, or operational activation by itself.",
  "schema": {
    "entry_required": [
      "ipr_label",
      "payload_sha256",
      "timestamp",
      "status"
    ],
    "entry_optional": [
      "record_scope",
      "note"
    ],
    "constraints": {
      "ipr_label": "Public minimal label only; must not contain raw personal identifiers or private evidence",
      "payload_sha256": "64-character lowercase hexadecimal SHA-256 digest",
      "timestamp": "ISO 8601 / RFC 3339 parseable timestamp",
      "status": "ACTIVE | REVOKED | SUSPENDED"
    },
    "forbidden_public_fields": [
      "private_key",
      "api_key",
      "token",
      "password",
      "secret",
      "credential",
      "raw_identifier",
      "identity_document",
      "private_evidence",
      "personal_payload",
      "production_log"
    ]
  },
  "verification": {
    "rule": "SHA256(canonical_ipr_record_or_commitment) MUST_MATCH entries[].payload_sha256",
    "valid_result": "VALID",
    "invalid_result": "INVALID",
    "missing_result": "NO_PUBLIC_RECORD",
    "non_operational_result": "NON_OPERATIONAL",
    "fail_closed_rule": "Missing, malformed, ambiguous, or inconsistent registry state must not produce VALID."
  },
  "entries": []
