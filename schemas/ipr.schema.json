{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://manuelcoletta1-source.github.io/hermeticum-bce-platform/schemas/ipr.schema.json",
  "title": "HBCE IPR Package — Public Proof Schema v3",
  "description": "Schema for a privacy-minimal IPR public proof package. It supports IPR Base, IPR Verified and IPR Professional pilot references while enforcing public proof minimization. Private identity verification evidence such as tax codes, document numbers, identity documents, scans, biometric material and private evidence must remain outside the public layer.",
  "type": "object",
  "additionalProperties": false,
  "allOf": [
    {
      "$ref": "#/$defs/noForbiddenKeys"
    }
  ],
  "required": [
    "proto",
    "kind",
    "version",
    "issuer_label",
    "seal",
    "issued_at",
    "ipr_profile",
    "verification_level",
    "subject_label",
    "purpose",
    "policy",
    "private_verification",
    "public_proof",
    "context",
    "audit"
  ],
  "properties": {
    "proto": {
      "type": "string",
      "const": "HBCE-IPR-PACKAGE"
    },
    "kind": {
      "type": "string",
      "const": "IPR_PUBLIC_PROOF_PACKAGE"
    },
    "version": {
      "type": "string",
      "const": "v3"
    },
    "issuer_label": {
      "type": "string",
      "minLength": 3,
      "maxLength": 96,
      "pattern": "^[A-Z0-9_\\-:.]+$",
      "description": "Public minimized issuer label. Must not contain names, tax codes, emails, phone numbers, document numbers, identity documents or private identifiers."
    },
    "seal": {
      "type": "string",
      "const": "HERMETICUM - BLINDATA · COMPUTABILE · EVOLUTIVA"
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "ipr_profile": {
      "type": "string",
      "enum": [
        "IPR_BASE",
        "IPR_VERIFIED",
        "IPR_PROFESSIONAL"
      ],
      "description": "Product profile. IPR_BASE is a technical R&D record. IPR_VERIFIED indicates that a private verification workflow exists outside the public layer. IPR_PROFESSIONAL is a pilot/business/audit profile based on IPR_VERIFIED."
    },
    "verification_level": {
      "type": "string",
      "enum": [
        "IPR_BASE_NOT_VERIFIED",
        "IPR_VERIFIED_PRIVATE_CHECK",
        "IPR_PROFESSIONAL_PILOT"
      ],
      "description": "Public verification-level label. This is a minimized public status indicator, not legal identity certification, regulated KYC/AML status, eIDAS qualification or public authority approval."
    },
    "subject_label": {
      "type": "string",
      "minLength": 3,
      "maxLength": 96,
      "pattern": "^[A-Z0-9_\\-:.]+$",
      "description": "Public minimized subject label. Must not contain names, tax codes, emails, phone numbers, document numbers, identity documents or private identifiers."
    },
    "payload_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "Optional top-level public hash commitment for the canonical package or controlled proof artifact."
    },
    "purpose": {
      "type": "string",
      "minLength": 3,
      "maxLength": 240
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "EU_FIRST",
        "GDPR_MIN",
        "PUBLIC_PROOF_MINIMIZATION",
        "PRIVATE_VERIFICATION_SEPARATION",
        "HASH_ORIENTED",
        "FAIL_CLOSED",
        "AUDIT_APPEND_ONLY",
        "NO_PUBLIC_DATA_CUSTODY",
        "NO_PUBLIC_TAX_CODE_CUSTODY",
        "NO_PUBLIC_DOCUMENT_NUMBER_CUSTODY",
        "NO_PUBLIC_IDENTITY_DOCUMENT_CUSTODY",
        "NO_REGULATED_CERTIFICATION_CLAIM",
        "NO_PUBLIC_AUTHORITY_CLAIM",
        "NO_EIDAS_QUALIFICATION_CLAIM",
        "NO_KYC_AML_PROVIDER_CLAIM"
      ],
      "properties": {
        "EU_FIRST": {
          "type": "boolean",
          "const": true
        },
        "GDPR_MIN": {
          "type": "boolean",
          "const": true
        },
        "PUBLIC_PROOF_MINIMIZATION": {
          "type": "boolean",
          "const": true
        },
        "PRIVATE_VERIFICATION_SEPARATION": {
          "type": "boolean",
          "const": true
        },
        "HASH_ORIENTED": {
          "type": "boolean",
          "const": true
        },
        "FAIL_CLOSED": {
          "type": "boolean",
          "const": true
        },
        "AUDIT_APPEND_ONLY": {
          "type": "boolean",
          "const": true
        },
        "NO_PUBLIC_DATA_CUSTODY": {
          "type": "boolean",
          "const": true
        },
        "NO_PUBLIC_TAX_CODE_CUSTODY": {
          "type": "boolean",
          "const": true
        },
        "NO_PUBLIC_DOCUMENT_NUMBER_CUSTODY": {
          "type": "boolean",
          "const": true
        },
        "NO_PUBLIC_IDENTITY_DOCUMENT_CUSTODY": {
          "type": "boolean",
          "const": true
        },
        "NO_REGULATED_CERTIFICATION_CLAIM": {
          "type": "boolean",
          "const": true
        },
        "NO_PUBLIC_AUTHORITY_CLAIM": {
          "type": "boolean",
          "const": true
        },
        "NO_EIDAS_QUALIFICATION_CLAIM": {
          "type": "boolean",
          "const": true
        },
        "NO_KYC_AML_PROVIDER_CLAIM": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "private_verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required_for_profile",
        "private_layer_only",
        "public_evidence_allowed",
        "allowed_private_evidence_categories",
        "public_forbidden_fields",
        "public_statement"
      ],
      "properties": {
        "required_for_profile": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": [
              "IPR_VERIFIED",
              "IPR_PROFESSIONAL"
            ]
          },
          "uniqueItems": true
        },
        "private_layer_only": {
          "type": "boolean",
          "const": true
        },
        "public_evidence_allowed": {
          "type": "string",
          "const": "MINIMIZED_PROOF_REFERENCE_ONLY"
        },
        "allowed_private_evidence_categories": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "string",
            "enum": [
              "TAX_CODE",
              "IDENTITY_CARD_OR_CIE",
              "PASSPORT",
              "DRIVING_LICENSE"
            ]
          },
          "uniqueItems": true,
          "description": "Private evidence category labels only. This field must never contain actual tax codes, document numbers, document images or personal payloads."
        },
        "public_forbidden_fields": {
          "type": "array",
          "minItems": 8,
          "items": {
            "type": "string",
            "enum": [
              "tax_code",
              "fiscal_code",
              "codice_fiscale",
              "document_number",
              "identity_document_number",
              "identity_card_number",
              "cie_number",
              "passport_number",
              "driving_license_number",
              "identity_document",
              "identity_document_scan",
              "portrait_image",
              "biometric_payload",
              "raw_identifier",
              "personal_data",
              "personal_payload",
              "private_evidence"
            ]
          },
          "uniqueItems": true
        },
        "public_statement": {
          "type": "string",
          "minLength": 20,
          "maxLength": 360,
          "description": "Human-readable public statement. Must state that private identity evidence remains outside the public layer."
        }
      }
    },
    "public_proof": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_kind",
        "payload_sha256",
        "proof_scope",
        "registry_visibility",
        "public_payload_policy"
      ],
      "properties": {
        "proof_kind": {
          "type": "string",
          "enum": [
            "IPR_BASE_PUBLIC_REFERENCE",
            "IPR_VERIFIED_PUBLIC_REFERENCE",
            "IPR_PROFESSIONAL_PUBLIC_REFERENCE",
            "IPR_AI_AUDIT_TRAIL_REFERENCE",
            "EVT_REFERENCE",
            "OPC_REFERENCE"
          ]
        },
        "payload_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "proof_scope": {
          "type": "string",
          "minLength": 3,
          "maxLength": 160
        },
        "registry_visibility": {
          "type": "string",
          "enum": [
            "PUBLIC_MINIMIZED",
            "PRIVATE_ONLY",
            "NOT_PUBLISHED"
          ]
        },
        "public_payload_policy": {
          "type": "string",
          "const": "HASH_ORIENTED_REFERENCE_ONLY"
        },
        "evt_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 3,
          "maxLength": 96,
          "pattern": "^[A-Z0-9_\\-:.]+$"
        },
        "opc_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 3,
          "maxLength": 96,
          "pattern": "^[A-Z0-9_\\-:.]+$"
        }
      }
    },
    "consent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "duration_days",
        "acknowledged"
      ],
      "properties": {
        "scope": {
          "type": "string",
          "enum": [
            "AI_ACCOUNTABILITY",
            "PROOF_OF_EXISTENCE",
            "AUDIT_TRAIL",
            "PUBLIC_PROOF_COMMITMENT",
            "OPERATIONAL_IDENTITY_RESEARCH",
            "IPR_VERIFIED_PRIVATE_CHECK"
          ]
        },
        "duration_days": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3650
        },
        "note": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 280
        },
        "acknowledged": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "context_sha256",
        "fields_present"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "PUBLIC_CONTEXT_COMMITMENT",
            "COARSE_GEO_COMMITMENT",
            "INSTITUTIONAL_CONTEXT_COMMITMENT",
            "RESEARCH_CONTEXT_COMMITMENT",
            "IPR_VERIFICATION_CONTEXT_COMMITMENT"
          ]
        },
        "context_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "fields_present": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "country",
              "region",
              "city",
              "public_label",
              "institutional_context",
              "research_context",
              "verification_level",
              "proof_scope"
            ]
          },
          "uniqueItems": true
        }
      }
    },
    "notes": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 2000
    },
    "audit": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "evt",
          "at",
          "by_label",
          "hash_sha256"
        ],
        "properties": {
          "evt": {
            "type": "string",
            "minLength": 3,
            "maxLength": 64,
            "pattern": "^[A-Z0-9_\\-:.]+$"
          },
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "by_label": {
            "type": "string",
            "minLength": 3,
            "maxLength": 96,
            "pattern": "^[A-Z0-9_\\-:.]+$"
          },
          "hash_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    }
  },
  "$defs": {
    "forbiddenPublicFieldNames": {
      "enum": [
        "name",
        "nickname",
        "email",
        "phone",
        "address",
        "birth_date",
        "date_of_birth",
        "territory",
        "raw_identifier",
        "tax_code",
        "fiscal_code",
        "codice_fiscale",
        "document_number",
        "identity_document_number",
        "identity_card_number",
        "cie_number",
        "passport_number",
        "driving_license_number",
        "identity_document",
        "regulated_identity_document",
        "identity_document_scan",
        "portrait_image",
        "biometric_payload",
        "private_evidence",
        "personal_payload",
        "personal_data",
        "api_key",
        "token",
        "password",
        "secret",
        "private_key",
        "credential",
        "production_log",
        "private_communication",
        "sensitive_operational_payload",
        "confidential_payload",
        "client_file",
        "raw_prompt",
        "raw_output"
      ]
    },
    "noForbiddenKeys": {
      "if": {
        "type": "object"
      },
      "then": {
        "propertyNames": {
          "not": {
            "$ref": "#/$defs/forbiddenPublicFieldNames"
          }
        }
      }
    }
  }
}
