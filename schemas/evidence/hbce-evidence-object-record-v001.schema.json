{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://manuelcoletta1-source.github.io/hermeticum-bce-platform/schemas/evidence/hbce-evidence-object-record-v001.schema.json",
  "title": "HBCE Evidence Object Record v001",
  "description": "R&D draft schema for HBCE public evidence objects. This schema draft is not a production registry, legal standard, certification mechanism or dispatch authorization contract.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "object_id",
    "artifact_type",
    "version",
    "status",
    "classification",
    "basis_marker",
    "basis_main_commit",
    "purpose",
    "public_surfaces",
    "release_anchor",
    "explicit_non_claims",
    "no_execution_boundary",
    "recommended_review_path",
    "result"
  ],
  "properties": {
    "object_id": {
      "type": "string",
      "minLength": 1
    },
    "artifact_type": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "minLength": 1
    },
    "classification": {
      "type": "string",
      "minLength": 1
    },
    "basis_marker": {
      "type": "string",
      "minLength": 1
    },
    "basis_main_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "public_surfaces": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "release_anchor": {
      "type": "object",
      "required": [
        "tag",
        "release"
      ],
      "properties": {
        "tag": {
          "type": "string",
          "minLength": 1
        },
        "release": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "explicit_non_claims": {
      "type": "object",
      "additionalProperties": {
        "type": "boolean"
      }
    },
    "no_execution_boundary": {
      "type": "object",
      "additionalProperties": {
        "type": "boolean"
      }
    },
    "recommended_review_path": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "result": {
      "type": "string",
      "minLength": 1
    }
  }
}
