{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hbce-access-authorization-record-hardened.schema.v001.json",
  "title": "HBCE Access Authorization Record Hardened Schema v001",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "object_id",
    "record_id",
    "artifact_type",
    "version",
    "status",
    "classification",
    "basis_marker",
    "basis_main_commit",
    "decision_scope",
    "authorization_level",
    "record_mode",
    "decision_outcome",
    "allowed_decision_outcomes",
    "required_bindings",
    "record_boundary",
    "explicit_non_claims",
    "no_execution_boundary",
    "expected_cli_marker",
    "expected_result",
    "result"
  ],
  "properties": {
    "object_id": {
      "type": "string",
      "pattern": "^HBCE-[A-Z0-9-]+-V[0-9]+$"
    },
    "record_id": {
      "type": "string",
      "pattern": "^HBCE-[A-Z0-9-]+-V[0-9]+$"
    },
    "artifact_type": {
      "type": "string",
      "enum": [
        "HBCEAccessAuthorizationRecord",
        "HBCEAccessAuthorizationDecisionRecord",
        "HBCERuntimeAccessGateRecord",
        "HBCEAccessAuthorizationRecordSchemaHardening"
      ]
    },
    "version": {
      "type": "string",
      "enum": [
        "v001"
      ]
    },
    "status": {
      "type": "string",
      "pattern": "^ACTIVE_[A-Z0-9_]+$"
    },
    "classification": {
      "type": "string",
      "enum": [
        "R_AND_D_ACCESS_AUTHORIZATION_RECORD_ONLY",
        "R_AND_D_ACCESS_AUTHORIZATION_DECISION_RECORD_ONLY",
        "R_AND_D_RUNTIME_ACCESS_GATE_RECORD_ONLY",
        "R_AND_D_ACCESS_AUTHORIZATION_RECORD_SCHEMA_HARDENING_ONLY"
      ]
    },
    "basis_marker": {
      "type": "string",
      "minLength": 1
    },
    "basis_main_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "decision_scope": {
      "type": "string",
      "const": "ACCESS_AUTHORIZATION"
    },
    "authorization_level": {
      "type": "string",
      "const": "ACCESS_ONLY"
    },
    "record_mode": {
      "type": "string",
      "enum": [
        "CONTROLLED_RECORD_ONLY",
        "CONTROLLED_DRAFT_RECORD_ONLY",
        "CONTROLLED_SCHEMA_HARDENING_ONLY"
      ]
    },
    "decision_outcome": {
      "type": "string",
      "enum": [
        "ACCESS_AUTHORIZATION_APPROVED_RECORD_ONLY",
        "ACCESS_AUTHORIZATION_DENIED_RECORD_ONLY",
        "ACCESS_AUTHORIZATION_UNKNOWN_FAIL_CLOSED_RECORD_ONLY",
        "RUNTIME_ACCESS_GATE_ALLOW_RECORD_ONLY",
        "RUNTIME_ACCESS_GATE_DENY_RECORD_ONLY",
        "RUNTIME_ACCESS_GATE_UNKNOWN_FAIL_CLOSED_RECORD_ONLY",
        "SCHEMA_HARDENING_RECORD_ONLY"
      ]
    },
    "allowed_decision_outcomes": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "ACCESS_AUTHORIZATION_APPROVED_RECORD_ONLY",
          "ACCESS_AUTHORIZATION_DENIED_RECORD_ONLY",
          "ACCESS_AUTHORIZATION_UNKNOWN_FAIL_CLOSED_RECORD_ONLY",
          "RUNTIME_ACCESS_GATE_ALLOW_RECORD_ONLY",
          "RUNTIME_ACCESS_GATE_DENY_RECORD_ONLY",
          "RUNTIME_ACCESS_GATE_UNKNOWN_FAIL_CLOSED_RECORD_ONLY",
          "SCHEMA_HARDENING_RECORD_ONLY"
        ]
      }
    },
    "required_bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_binding_required",
        "authority_ref_required",
        "policy_evaluation_required",
        "access_authorization_predicate_required",
        "access_authorization_decision_record_required",
        "decision_actor_required",
        "decision_scope_required",
        "authorization_level_required"
      ],
      "properties": {
        "request_binding_required": {
          "type": "boolean",
          "const": true
        },
        "authority_ref_required": {
          "type": "boolean",
          "const": true
        },
        "policy_evaluation_required": {
          "type": "boolean",
          "const": true
        },
        "access_authorization_predicate_required": {
          "type": "boolean",
          "const": true
        },
        "access_authorization_decision_record_required": {
          "type": "boolean",
          "const": true
        },
        "positive_authorization_contract_required_for_allow": {
          "type": "boolean",
          "const": true
        },
        "runtime_gate_required_for_runtime_record": {
          "type": "boolean"
        },
        "decision_actor_required": {
          "type": "boolean",
          "const": true
        },
        "decision_scope_required": {
          "type": "string",
          "const": "ACCESS_AUTHORIZATION"
        },
        "authorization_level_required": {
          "type": "string",
          "const": "ACCESS_ONLY"
        }
      }
    },
    "record_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_only",
        "runtime_gate_implemented",
        "runtime_gate_enabled",
        "production_authorization_service_enabled",
        "access_granted",
        "dispatch_authorized",
        "execution_authorized",
        "execution_trace_created",
        "effect_evidence_created",
        "legal_certification_created"
      ],
      "properties": {
        "record_only": {
          "type": "boolean",
          "const": true
        },
        "runtime_gate_implemented": {
          "type": "boolean",
          "const": false
        },
        "runtime_gate_enabled": {
          "type": "boolean",
          "const": false
        },
        "production_authorization_service_enabled": {
          "type": "boolean",
          "const": false
        },
        "access_granted": {
          "type": "boolean",
          "const": false
        },
        "dispatch_authorized": {
          "type": "boolean",
          "const": false
        },
        "execution_authorized": {
          "type": "boolean",
          "const": false
        },
        "execution_trace_created": {
          "type": "boolean",
          "const": false
        },
        "effect_evidence_created": {
          "type": "boolean",
          "const": false
        },
        "legal_certification_created": {
          "type": "boolean",
          "const": false
        }
      }
    },
    "explicit_non_claims": {
      "type": "object",
      "additionalProperties": {
        "type": "boolean",
        "const": true
      },
      "required": [
        "does_not_claim_runtime_gate_implemented",
        "does_not_claim_runtime_gate_enabled",
        "does_not_claim_access_granted",
        "does_not_claim_dispatch_authorization",
        "does_not_claim_execution_authorization",
        "does_not_claim_production_authorization_service",
        "does_not_claim_onboarding_execution",
        "does_not_claim_identity_verification",
        "does_not_claim_certificate_issuance",
        "does_not_claim_target_receipt",
        "does_not_claim_execution_trace",
        "does_not_claim_effect_evidence",
        "does_not_claim_legal_certification"
      ]
    },
    "no_execution_boundary": {
      "type": "object",
      "additionalProperties": {
        "type": "boolean",
        "const": false
      },
      "required": [
        "runtime_gate_implemented",
        "runtime_gate_enabled",
        "access_granted",
        "dispatch_execution_authorized",
        "execution_authorized",
        "production_authorization_service_enabled",
        "onboarding_started",
        "identity_verified",
        "certificate_issued",
        "target_receipt_created",
        "execution_trace_created",
        "effect_evidence_created",
        "legal_certification_created"
      ]
    },
    "expected_cli_marker": {
      "type": "string",
      "minLength": 1
    },
    "expected_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required_field_count",
        "allowed_decision_outcome_count",
        "required_non_claim_count",
        "required_no_execution_boundary_count",
        "result"
      ],
      "properties": {
        "required_field_count": {
          "type": "integer",
          "const": 20
        },
        "allowed_decision_outcome_count": {
          "type": "integer",
          "const": 7
        },
        "required_non_claim_count": {
          "type": "integer",
          "const": 13
        },
        "required_no_execution_boundary_count": {
          "type": "integer",
          "const": 13
        },
        "result": {
          "type": "string",
          "const": "PASS_ACCESS_AUTHORIZATION_RECORD_SCHEMA_HARDENING"
        }
      }
    },
    "result": {
      "type": "string",
      "enum": [
        "PASS_ACCESS_AUTHORIZATION_RECORD_SCHEMA_HARDENING_CREATED",
        "PASS_ACCESS_AUTHORIZATION_RECORD_SCHEMA_HARDENING"
      ]
    }
  }
}
