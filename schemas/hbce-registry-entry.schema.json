{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://manuelcoletta1-source.github.io/hermeticum-bce-platform/schemas/hbce-registry-entry.schema.json",
  "title": "HBCE Registry Entry — Public Proof Reference v3",
  "description": "Privacy-minimal public registry entry schema for HBCE / IPR / IPR Verified / EVT / OPC proof references. The public registry may expose minimized proof metadata and verification_level values, but must never expose tax codes, document numbers, identity documents, scans, biometric material, private evidence, secrets or sensitive operational payloads.",
  "type": "object",
  "additionalProperties": false,
  "allOf": [
    {
      "$ref": "#/$defs/noForbiddenKeys"
    }
  ],
  "required": [
    "proto",
    "kind",
    "version",
    "entity_type",
    "subject_label",
    "record_scope",
    "verification_level",
    "payload_sha256",
    "timestamp",
    "status",
    "public_payload_policy",
    "boundary"
  ],
  "properties": {
    "proto": {
      "type": "string",
      "const": "HBCE-REGISTRY-v3"
    },
    "kind": {
      "type": "string",
      "enum": [
        "HBCE_PUBLIC_PROOF_RND_REFERENCE",
        "IPR_PUBLIC_PROOF_RND_REFERENCE",
        "IPR_BASE_PUBLIC_REFERENCE",
        "IPR_VERIFIED_PUBLIC_REFERENCE",
        "IPR_PROFESSIONAL_PUBLIC_REFERENCE",
        "EVT_PUBLIC_REFERENCE",
        "OPC_PUBLIC_REFERENCE",
        "IPR_AI_AUDIT_TRAIL_PUBLIC_REFERENCE"
      ]
    },
    "version": {
      "type": "string",
      "const": "v3"
    },
    "entity_type": {
      "type": "string",
      "enum": [
        "IPR",
        "IPR_BASE",
        "IPR_VERIFIED",
        "IPR_PROFESSIONAL",
        "EVT",
        "OPC",
        "EVIDENCE_PACK",
        "AI_AUDIT_TRAIL",
        "NODE",
        "OPERATOR",
        "SYSTEM"
      ]
    },
    "subject_label": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[A-Z0-9_\\-:.]+$",
      "description": "Public minimized subject label. Must not contain names, emails, phone numbers, tax codes, document numbers, identity documents or private identifiers."
    },
    "operator_label": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[A-Z0-9_\\-:.]+$",
      "description": "Optional minimized operator label. Must not contain raw personal identifiers."
    },
    "record_scope": {
      "type": "string",
      "enum": [
        "IPR_BASE_RND_REFERENCE",
        "IPR_VERIFIED_PRIVATE_CHECK_REFERENCE",
        "IPR_PROFESSIONAL_PILOT_REFERENCE",
        "IPR_AI_AUDIT_TRAIL_MVP",
        "EVT_CONTINUITY_REFERENCE",
        "OPC_PROOF_REFERENCE",
        "EVIDENCE_PACK_REFERENCE",
        "REGISTRY_V3_REFERENCE",
        "HBCE_RND_REFERENCE",
        "INTERNAL_SELF_PILOT"
      ]
    },
    "verification_level": {
      "type": "string",
      "enum": [
        "IPR_BASE_NOT_VERIFIED",
        "IPR_VERIFIED_PRIVATE_CHECK",
        "IPR_PROFESSIONAL_PILOT",
        "RND_ONLY",
        "NOT_APPLICABLE"
      ],
      "description": "Public minimized verification-level label. It does not create legal identity, regulated KYC/AML compliance, eIDAS qualification, public authority approval or certification by itself."
    },
    "payload_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "Hash-oriented proof reference. The underlying payload must remain outside the public layer if it contains private or sensitive material."
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "ACTIVE",
        "RND_ONLY",
        "RETAINED",
        "SUSPENDED",
        "REVOKED",
        "SUPERSEDED",
        "INVALID",
        "PRIVATE_REVIEW_REQUIRED",
        "FAIL_CLOSED"
      ]
    },
    "public_payload_policy": {
      "type": "string",
      "const": "HASH_ORIENTED_REFERENCE_ONLY"
    },
    "evt_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^(EVT-[0-9]{4,}|EVT-[A-Z0-9\\-]{4,96})$"
    },
    "opc_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 3,
      "maxLength": 96,
      "pattern": "^[A-Z0-9_\\-:.]+$"
    },
    "proof_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[A-Z0-9_\\-:.]+$"
    },
    "evidence_pack_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[A-Z0-9_\\-:.]+$"
    },
    "source_route": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 180,
      "pattern": "^[A-Za-z0-9_./:\\-]+$"
    },
    "note": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 600,
      "description": "Short public-safe note only. Must not contain personal data, tax codes, document numbers, secrets or private evidence."
    },
    "boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "private_verification_separation",
        "public_proof_minimization",
        "no_public_data_custody",
        "no_public_tax_code_custody",
        "no_public_document_number_custody",
        "no_public_identity_document_custody",
        "no_private_key_custody",
        "no_regulated_certification_claim",
        "no_public_authority_claim",
        "no_eidas_qualification_claim",
        "no_kyc_aml_provider_claim",
        "fail_closed"
      ],
      "properties": {
        "scope": {
          "type": "string",
          "enum": [
            "RND_REFERENCE",
            "IPR_BASE_RND_REFERENCE",
            "IPR_VERIFIED_PRIVATE_CHECK_REFERENCE",
            "IPR_PROFESSIONAL_PILOT_REFERENCE",
            "IPR_AI_AUDIT_TRAIL_REFERENCE",
            "EVT_REFERENCE",
            "OPC_REFERENCE",
            "EVIDENCE_PACK_REFERENCE"
          ]
        },
        "private_verification_separation": {
          "type": "boolean",
          "const": true
        },
        "public_proof_minimization": {
          "type": "boolean",
          "const": true
        },
        "no_public_data_custody": {
          "type": "boolean",
          "const": true
        },
        "no_public_tax_code_custody": {
          "type": "boolean",
          "const": true
        },
        "no_public_document_number_custody": {
          "type": "boolean",
          "const": true
        },
        "no_public_identity_document_custody": {
          "type": "boolean",
          "const": true
        },
        "no_private_key_custody": {
          "type": "boolean",
          "const": true
        },
        "no_regulated_certification_claim": {
          "type": "boolean",
          "const": true
        },
        "no_public_authority_claim": {
          "type": "boolean",
          "const": true
        },
        "no_eidas_qualification_claim": {
          "type": "boolean",
          "const": true
        },
        "no_kyc_aml_provider_claim": {
          "type": "boolean",
          "const": true
        },
        "fail_closed": {
          "type": "boolean",
          "const": true
        }
      }
    }
  },
  "$defs": {
    "forbiddenPublicFieldNames": {
      "enum": [
        "name",
        "nickname",
        "email",
        "phone",
        "address",
        "birth_date",
        "date_of_birth",
        "street_address",
        "precise_location",
        "territory",
        "raw_identifier",
        "tax_code",
        "fiscal_code",
        "codice_fiscale",
        "document_number",
        "identity_document_number",
        "identity_card_number",
        "cie_number",
        "passport_number",
        "driving_license_number",
        "identity_document",
        "regulated_identity_document",
        "identity_document_scan",
        "passport_scan",
        "driving_license_scan",
        "portrait_image",
        "selfie",
        "biometric_payload",
        "private_evidence",
        "personal_payload",
        "personal_data",
        "api_key",
        "token",
        "password",
        "secret",
        "private_key",
        "credential",
        "production_log",
        "private_communication",
        "sensitive_operational_payload",
        "financial_asset",
        "confidential_payload",
        "client_file",
        "raw_prompt",
        "raw_output",
        "internal_endpoint",
        "private_ip",
        "internal_hostname",
        "database_url",
        "admin_url",
        "ssh_key"
      ]
    },
    "noForbiddenKeys": {
      "if": {
        "type": "object"
      },
      "then": {
        "propertyNames": {
          "not": {
            "$ref": "#/$defs/forbiddenPublicFieldNames"
          }
        },
        "additionalProperties": {
          "$ref": "#/$defs/noForbiddenKeys"
        }
      },
      "else": {
        "if": {
          "type": "array"
        },
        "then": {
          "items": {
            "$ref": "#/$defs/noForbiddenKeys"
          }
        }
      }
    }
  }
}
