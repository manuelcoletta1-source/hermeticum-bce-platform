{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://manuelcoletta1-source.github.io/hermeticum-bce-platform/schemas/hbce-evt.schema.json",
  "title": "HBCE EVT — Operational Update v2",
  "description": "Canonical schema for HBCE EVT operational update records. EVT records are controlled operational preimages used for continuity, audit, anchoring and public proof commitment generation. Public registries must publish only minimized hash-oriented commitments and must not expose tax codes, document numbers, identity documents, private evidence, biometric material or sensitive operational payloads.",
  "type": "object",
  "additionalProperties": false,
  "allOf": [
    {
      "$ref": "#/$defs/noForbiddenKeys"
    }
  ],
  "required": [
    "evt",
    "prev",
    "t",
    "entity",
    "ipr",
    "verification_level",
    "state",
    "baseline",
    "kind",
    "cycle",
    "loc",
    "org",
    "core",
    "anchors",
    "upstream",
    "continuity",
    "public_payload_policy",
    "boundary"
  ],
  "properties": {
    "evt": {
      "type": "string",
      "pattern": "^EVT-[0-9]{4,}$",
      "description": "Canonical event identifier."
    },
    "prev": {
      "type": "string",
      "pattern": "^(GENESIS|EVT-[0-9]{4,})$",
      "description": "Previous event identifier in the continuity chain. GENESIS is allowed only for the first event."
    },
    "t": {
      "type": "string",
      "format": "date-time",
      "description": "Event timestamp in ISO 8601 / RFC 3339 format."
    },
    "entity": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[A-Z0-9_\\-:.]+$",
      "description": "Operational entity label. Public registries should use minimized labels or hash commitments where appropriate."
    },
    "ipr": {
      "type": "string",
      "minLength": 3,
      "maxLength": 96,
      "pattern": "^[A-Z0-9_\\-:.]+$",
      "description": "Operational IPR label. Must not contain raw identity data."
    },
    "verification_level": {
      "type": "string",
      "enum": [
        "IPR_BASE_NOT_VERIFIED",
        "IPR_VERIFIED_PRIVATE_CHECK",
        "IPR_PROFESSIONAL_PILOT",
        "RND_ONLY",
        "NOT_APPLICABLE"
      ],
      "description": "Public minimized verification-level label. This does not create legal identity, regulated KYC/AML compliance, eIDAS qualification, public authority approval or certification by itself."
    },
    "state": {
      "type": "string",
      "enum": [
        "LOCKED",
        "ACTIVE",
        "INACTIVE",
        "SUSPENDED",
        "REVOKED",
        "EXPERIMENTAL",
        "PRIVATE_REVIEW_REQUIRED",
        "FAIL_CLOSED"
      ]
    },
    "baseline": {
      "type": "boolean"
    },
    "kind": {
      "type": "string",
      "enum": [
        "OPERATIONAL_UPDATE",
        "BASELINE",
        "REGISTRY_UPDATE",
        "AUDIT_EVENT",
        "CONTINUITY_CHECKPOINT",
        "ANCHOR_EVENT",
        "STATUS_UPDATE",
        "IPR_BASE_EVENT",
        "IPR_VERIFIED_PRIVATE_CHECK_EVENT",
        "IPR_PROFESSIONAL_PILOT_EVENT",
        "IPR_AI_AUDIT_TRAIL_EVENT"
      ]
    },
    "cycle": {
      "type": "string",
      "minLength": 3,
      "maxLength": 64,
      "pattern": "^[A-Z0-9_\\-:.]+$"
    },
    "loc": {
      "type": "array",
      "description": "Coarse public location labels only. Do not include street address, exact coordinates or sensitive location data.",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "string",
        "minLength": 2,
        "maxLength": 64
      }
    },
    "org": {
      "type": "string",
      "minLength": 2,
      "maxLength": 160
    },
    "core": {
      "type": "string",
      "minLength": 3,
      "maxLength": 96,
      "pattern": "^[A-Z0-9_\\-:.]+$"
    },
    "public_payload_policy": {
      "type": "string",
      "const": "HASH_ORIENTED_REFERENCE_ONLY",
      "description": "Public payload policy. EVT public references must be hash-oriented and minimized."
    },
    "anchors": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "monthly_hash",
        "ipfs_cid",
        "btc_txid",
        "evm_tx_hash"
      ],
      "properties": {
        "monthly_hash": {
          "type": "string",
          "minLength": 8,
          "maxLength": 256,
          "description": "Monthly checkpoint hash or placeholder for the canonical hash commitment."
        },
        "ipfs_cid": {
          "type": "string",
          "minLength": 8,
          "maxLength": 256
        },
        "btc_txid": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "evm_tx_hash": {
          "type": "string",
          "pattern": "^0x[a-fA-F0-9]{64}$"
        }
      }
    },
    "upstream": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root_evt",
        "root_t",
        "proto",
        "t0"
      ],
      "properties": {
        "root_evt": {
          "type": "string",
          "pattern": "^(GENESIS|EVT-[0-9]{4,})$"
        },
        "root_t": {
          "type": "string",
          "format": "date-time"
        },
        "proto": {
          "type": "string",
          "minLength": 3,
          "maxLength": 96
        },
        "inrim": {
          "type": "string",
          "minLength": 3,
          "maxLength": 128,
          "description": "Optional public institutional reference label. Do not include confidential correspondence or private documents."
        },
        "t0": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "continuity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "checkpoint_type",
        "elapsed_months",
        "origin_ipr",
        "rule",
        "note"
      ],
      "properties": {
        "checkpoint_type": {
          "type": "string",
          "enum": [
            "CANONICAL",
            "EXPERIMENTAL",
            "DERIVED",
            "AUDIT",
            "PUBLIC_REFERENCE",
            "PRIVATE_VERIFICATION_REFERENCE",
            "IPR_VERIFIED_REFERENCE"
          ]
        },
        "elapsed_months": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1200
        },
        "origin_ipr": {
          "type": "string",
          "minLength": 3,
          "maxLength": 96,
          "pattern": "^[A-Z0-9_\\-:.]+$"
        },
        "rule": {
          "type": "string",
          "minLength": 3,
          "maxLength": 512
        },
        "note": {
          "type": "string",
          "minLength": 3,
          "maxLength": 1024
        }
      }
    },
    "proof": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_kind",
        "payload_sha256",
        "proof_scope"
      ],
      "properties": {
        "proof_kind": {
          "type": "string",
          "enum": [
            "IPR_BASE_PUBLIC_REFERENCE",
            "IPR_VERIFIED_PUBLIC_REFERENCE",
            "IPR_PROFESSIONAL_PUBLIC_REFERENCE",
            "IPR_AI_AUDIT_TRAIL_REFERENCE",
            "EVT_REFERENCE",
            "OPC_REFERENCE"
          ]
        },
        "payload_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "proof_scope": {
          "type": "string",
          "minLength": 3,
          "maxLength": 160
        },
        "registry_visibility": {
          "type": "string",
          "enum": [
            "PUBLIC_MINIMIZED",
            "PRIVATE_ONLY",
            "NOT_PUBLISHED"
          ]
        },
        "evt_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^(EVT-[0-9]{4,}|EVT-[A-Z0-9\\-]{4,96})$"
        },
        "opc_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 3,
          "maxLength": 96,
          "pattern": "^[A-Z0-9_\\-:.]+$"
        }
      }
    },
    "private_verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "private_layer_only",
        "public_evidence_allowed",
        "allowed_private_evidence_categories",
        "public_statement"
      ],
      "properties": {
        "private_layer_only": {
          "type": "boolean",
          "const": true
        },
        "public_evidence_allowed": {
          "type": "string",
          "const": "MINIMIZED_PROOF_REFERENCE_ONLY"
        },
        "allowed_private_evidence_categories": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "TAX_CODE",
              "IDENTITY_CARD_OR_CIE",
              "PASSPORT",
              "DRIVING_LICENSE"
            ]
          },
          "uniqueItems": true
        },
        "public_statement": {
          "type": "string",
          "minLength": 20,
          "maxLength": 360,
          "description": "Human-readable statement explaining that private identity evidence remains outside the public layer."
        }
      }
    },
    "boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "private_verification_separation",
        "public_proof_minimization",
        "no_public_data_custody",
        "no_public_tax_code_custody",
        "no_public_document_number_custody",
        "no_public_identity_document_custody",
        "no_private_key_custody",
        "no_regulated_certification_claim",
        "no_public_authority_claim",
        "no_eidas_qualification_claim",
        "no_kyc_aml_provider_claim",
        "fail_closed"
      ],
      "properties": {
        "scope": {
          "type": "string",
          "enum": [
            "RND_REFERENCE",
            "IPR_BASE_RND_REFERENCE",
            "IPR_VERIFIED_PRIVATE_CHECK_REFERENCE",
            "IPR_AI_AUDIT_TRAIL_REFERENCE",
            "CONTINUITY_CHECKPOINT_REFERENCE"
          ]
        },
        "private_verification_separation": {
          "type": "boolean",
          "const": true
        },
        "public_proof_minimization": {
          "type": "boolean",
          "const": true
        },
        "no_public_data_custody": {
          "type": "boolean",
          "const": true
        },
        "no_public_tax_code_custody": {
          "type": "boolean",
          "const": true
        },
        "no_public_document_number_custody": {
          "type": "boolean",
          "const": true
        },
        "no_public_identity_document_custody": {
          "type": "boolean",
          "const": true
        },
        "no_private_key_custody": {
          "type": "boolean",
          "const": true
        },
        "no_regulated_certification_claim": {
          "type": "boolean",
          "const": true
        },
        "no_public_authority_claim": {
          "type": "boolean",
          "const": true
        },
        "no_eidas_qualification_claim": {
          "type": "boolean",
          "const": true
        },
        "no_kyc_aml_provider_claim": {
          "type": "boolean",
          "const": true
        },
        "fail_closed": {
          "type": "boolean",
          "const": true
        }
      }
    }
  },
  "$defs": {
    "forbiddenPublicFieldNames": {
      "enum": [
        "name",
        "nickname",
        "email",
        "phone",
        "address",
        "birth_date",
        "date_of_birth",
        "street_address",
        "precise_location",
        "territory",
        "raw_identifier",
        "tax_code",
        "fiscal_code",
        "codice_fiscale",
        "document_number",
        "identity_document_number",
        "identity_card_number",
        "cie_number",
        "passport_number",
        "driving_license_number",
        "identity_document",
        "regulated_identity_document",
        "identity_document_scan",
        "passport_scan",
        "driving_license_scan",
        "portrait_image",
        "selfie",
        "biometric_payload",
        "private_evidence",
        "personal_payload",
        "personal_data",
        "api_key",
        "token",
        "password",
        "secret",
        "private_key",
        "credential",
        "production_log",
        "private_communication",
        "sensitive_operational_payload",
        "financial_asset",
        "confidential_payload",
        "client_file",
        "raw_prompt",
        "raw_output",
        "internal_endpoint",
        "private_ip",
        "internal_hostname",
        "database_url",
        "admin_url",
        "ssh_key"
      ]
    },
    "noForbiddenKeys": {
      "if": {
        "type": "object"
      },
      "then": {
        "propertyNames": {
          "not": {
            "$ref": "#/$defs/forbiddenPublicFieldNames"
          }
        },
        "additionalProperties": {
          "$ref": "#/$defs/noForbiddenKeys"
        }
      },
      "else": {
        "if": {
          "type": "array"
        },
        "then": {
          "items": {
            "$ref": "#/$defs/noForbiddenKeys"
          }
        }
      }
    }
  }
}
