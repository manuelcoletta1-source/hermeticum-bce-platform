{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://manuelcoletta1-source.github.io/hermeticum-bce-platform/schemas/hbce-evt.schema.json",
  "title": "HBCE EVT R&D Event Schema v3",
  "description": "Privacy-minimal R&D schema for HBCE / IPR / IPR Verified / IPR AI Audit Trail event records. Supports verification_level metadata while enforcing hash-oriented public proof, append-only behavior, fail-closed validation and no public identity-data custody.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "proto",
    "kind",
    "event_id",
    "entity_id",
    "event_type",
    "event_payload_sha256",
    "timestamp",
    "operator_reference",
    "status",
    "append_only",
    "public_payload_policy",
    "verification_level",
    "boundary"
  ],
  "properties": {
    "proto": {
      "type": "string",
      "const": "HBCE-REGISTRY-v3"
    },
    "kind": {
      "type": "string",
      "enum": [
        "IPR_EVENT_RECORD_RND_REFERENCE",
        "HBCE_EVT_RND_REFERENCE",
        "IPR_AI_AUDIT_TRAIL_EVENT_RND_REFERENCE",
        "IPR_VERIFIED_EVENT_RND_REFERENCE",
        "MATRIX_AUDIT_EVENT_RND_REFERENCE"
      ]
    },
    "event_id": {
      "type": "string",
      "pattern": "^EVT-[A-Z0-9\\-]{4,96}$"
    },
    "entity_id": {
      "type": "string",
      "pattern": "^[A-Z0-9_:\\-.]{4,128}$",
      "description": "Public minimized entity reference. Must not contain names, tax codes, document numbers, emails, phone numbers or private identifiers."
    },
    "event_type": {
      "type": "string",
      "enum": [
        "IPR_BASE_CREATED",
        "IPR_VERIFIED_PRIVATE_CHECK_RECORDED",
        "IPR_PROFESSIONAL_PILOT_RECORDED",
        "AI_OUTPUT_RECORDED",
        "AI_OUTPUT_REVIEWED",
        "HUMAN_VALIDATION",
        "GOVERNANCE_DECISION",
        "POLICY_CHECK",
        "RISK_ASSESSMENT",
        "AUDIT_NOTE",
        "EVIDENCE_PACK_CREATED",
        "REGISTRY_STATUS_UPDATE",
        "VERIFICATION_REQUEST",
        "VERIFICATION_RESULT",
        "ACCESS_EVENT",
        "SECURITY_NOTICE"
      ]
    },
    "event_payload_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "Hash-oriented commitment for the event payload. The payload itself must not expose tax codes, identity documents, document numbers or private evidence in public records."
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "operator_reference": {
      "type": "string",
      "pattern": "^[A-Z0-9_:\\-.]{4,128}$"
    },
    "status": {
      "type": "string",
      "enum": [
        "VALID",
        "INVALID",
        "REVOKED",
        "DRAFT",
        "RND_ONLY",
        "RECORDED",
        "SUPERSEDED",
        "EXPERIMENTAL",
        "PRIVATE_REVIEW_REQUIRED",
        "FAIL_CLOSED"
      ]
    },
    "verification_level": {
      "type": "string",
      "enum": [
        "IPR_BASE_NOT_VERIFIED",
        "IPR_VERIFIED_PRIVATE_CHECK",
        "IPR_PROFESSIONAL_PILOT",
        "RND_ONLY",
        "NOT_APPLICABLE"
      ],
      "description": "Public minimized verification-level label. It does not create legal identity, regulated KYC/AML compliance, eIDAS qualification, public authority approval or certification by itself."
    },
    "append_only": {
      "type": "boolean",
      "const": true
    },
    "public_payload_policy": {
      "type": "string",
      "const": "HASH_ORIENTED_REFERENCE_ONLY"
    },
    "context": {
      "type": "string",
      "enum": [
        "IPR_BASE_RND_REFERENCE",
        "IPR_VERIFIED_PRIVATE_CHECK",
        "IPR_AI_AUDIT_TRAIL_MVP",
        "HBCE_RND_REFERENCE",
        "REGISTRY_V3_REFERENCE",
        "PRIVATE_VERIFICATION_BOUNDARY",
        "TECHNICAL_EVIDENCE_PACK"
      ]
    },
    "risk_class": {
      "type": "string",
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH",
        "REVIEW_REQUIRED"
      ]
    },
    "verification_reference": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_./:\\-]{3,160}$"
    },
    "evidence_reference": {
      "type": "string",
      "pattern": "^[A-Z0-9_:\\-.]{3,160}$"
    },
    "ipr_reference": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[A-Z0-9_:\\-.]{3,160}$"
    },
    "evt_prev": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^EVT-[A-Z0-9\\-]{4,96}$"
    },
    "opc_reference": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[A-Z0-9_:\\-.]{3,160}$"
    },
    "note": {
      "type": "string",
      "maxLength": 600
    },
    "boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "no_public_data_custody",
        "no_public_tax_code_custody",
        "no_public_document_number_custody",
        "no_public_identity_document_custody",
        "no_private_key_custody",
        "no_regulated_certification_claim",
        "no_public_authority_claim",
        "no_eidas_qualification_claim",
        "no_kyc_aml_provider_claim",
        "fail_closed"
      ],
      "properties": {
        "scope": {
          "type": "string",
          "enum": [
            "RND_REFERENCE",
            "IPR_BASE_RND_REFERENCE",
            "IPR_VERIFIED_PRIVATE_CHECK_REFERENCE",
            "IPR_AI_AUDIT_TRAIL_REFERENCE"
          ]
        },
        "private_verification_separation": {
          "type": "boolean",
          "const": true
        },
        "public_proof_minimization": {
          "type": "boolean",
          "const": true
        },
        "no_public_data_custody": {
          "type": "boolean",
          "const": true
        },
        "no_public_tax_code_custody": {
          "type": "boolean",
          "const": true
        },
        "no_public_document_number_custody": {
          "type": "boolean",
          "const": true
        },
        "no_public_identity_document_custody": {
          "type": "boolean",
          "const": true
        },
        "no_private_key_custody": {
          "type": "boolean",
          "const": true
        },
        "no_regulated_certification_claim": {
          "type": "boolean",
          "const": true
        },
        "no_public_authority_claim": {
          "type": "boolean",
          "const": true
        },
        "no_eidas_qualification_claim": {
          "type": "boolean",
          "const": true
        },
        "no_kyc_aml_provider_claim": {
          "type": "boolean",
          "const": true
        },
        "fail_closed": {
          "type": "boolean",
          "const": true
        }
      }
    }
  },
  "allOf": [
    {
      "$ref": "#/$defs/noForbiddenKeys"
    }
  ],
  "$defs": {
    "forbiddenPublicFieldNames": {
      "enum": [
        "name",
        "nickname",
        "email",
        "phone",
        "address",
        "birth_date",
        "date_of_birth",
        "territory",
        "raw_identifier",
        "tax_code",
        "fiscal_code",
        "codice_fiscale",
        "document_number",
        "identity_document_number",
        "identity_card_number",
        "cie_number",
        "passport_number",
        "driving_license_number",
        "identity_document",
        "regulated_identity_document",
        "identity_document_scan",
        "passport_scan",
        "driving_license_scan",
        "portrait_image",
        "selfie",
        "biometric_payload",
        "private_evidence",
        "personal_payload",
        "personal_data",
        "api_key",
        "token",
        "password",
        "secret",
        "private_key",
        "credential",
        "production_log",
        "private_communication",
        "sensitive_operational_payload",
        "financial_asset",
        "confidential_payload",
        "client_file",
        "raw_prompt",
        "raw_output",
        "internal_endpoint",
        "private_ip",
        "internal_hostname",
        "database_url",
        "admin_url",
        "ssh_key"
      ]
    },
    "noForbiddenKeys": {
      "if": {
        "type": "object"
      },
      "then": {
        "propertyNames": {
          "not": {
            "$ref": "#/$defs/forbiddenPublicFieldNames"
          }
        }
      }
    }
  }
}
