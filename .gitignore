# HBCE Platform — example environment file
# This repository is primarily a public static gateway.
# Do not commit real secrets, API keys, private keys, credentials, tokens,
# identity documents, private evidence, or sensitive operational payloads.

# OpenAI / API examples
# OPENAI_API_KEY=your_openai_api_key_here
# JOKER_MODEL=your_model_name_here

# Registry / verification examples
# HBCE_REGISTRY_SOURCE=/hermeticum-bce-platform/registry/registry.json
# HBCE_REGISTRY_MODE=FAIL_CLOSED
# HBCE_PUBLIC_DATA_MODE=HASH_ONLY

# Audit / environment examples
# HBCE_ENV=development
# HBCE_AUDIT_MODE=defensive
# HBCE_DATA_CUSTODY=NO_PUBLIC_DATA_CUSTODY

# Security reminder
# Real values must be stored only in secure local or deployment environments.
# Never publish .env files, secrets, private keys, credentials, tokens,
# private evidence, or personal identity documents in the public repository.
