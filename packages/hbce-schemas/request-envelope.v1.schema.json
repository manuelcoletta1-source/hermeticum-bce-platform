{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hbce.p0.request-envelope",
  "title": "HBCE P0 RequestEnvelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "idempotency_key",
    "created_at",
    "actor_ref",
    "authority_ref",
    "action_binding",
    "target_ref",
    "request_payload_hash"
  ],
  "properties": {
    "schema_version": {
      "const": "hbce.p0.request-envelope.v1"
    },
    "request_id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 160
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 16,
      "maxLength": 200
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "actor_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actor_id",
        "actor_type",
        "session_id"
      ],
      "properties": {
        "actor_id": {
          "type": "string",
          "minLength": 1
        },
        "actor_type": {
          "enum": [
            "human",
            "service",
            "ai_agent"
          ]
        },
        "session_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "authority_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority_id",
        "authority_version",
        "authority_hash"
      ],
      "properties": {
        "authority_id": {
          "type": "string",
          "minLength": 1
        },
        "authority_version": {
          "type": "string",
          "minLength": 1
        },
        "authority_hash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    },
    "action_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action_id",
        "action_class",
        "action_version",
        "action_hash"
      ],
      "properties": {
        "action_id": {
          "type": "string",
          "minLength": 1
        },
        "action_class": {
          "enum": [
            "AI_TOOL_ACCESS",
            "BANK_CRITICAL_ACTION",
            "P0_TEST_ACTION"
          ]
        },
        "action_version": {
          "type": "string",
          "minLength": 1
        },
        "action_hash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    },
    "target_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_id",
        "target_type"
      ],
      "properties": {
        "target_id": {
          "type": "string",
          "minLength": 1
        },
        "target_type": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "request_payload_hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  }
}
