      "test_id": "T224",
      "stimulus": "Nested token NEW_EVALUATION::OPERATIONAL::ALLOWED used as state",
      "required_result": "TOKEN_SHAPE_INVALID",
      "invariant": "Evaluation identity lives in fields, not nested state tokens"
    },
    {
      "test_id": "T225",
      "stimulus": "CONTRACT::* transition produced by producer other than PRODUCER::CONTRACT_CONTROL",
      "required_result": "CONTRACT_PRODUCER_INVALID / TRANSITION_DENIED",
      "invariant": "CONTRACT lifecycle remains producer-bound to CONTRACT_CONTROL"
    }
