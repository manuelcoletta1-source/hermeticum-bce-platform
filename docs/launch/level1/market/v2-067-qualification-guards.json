  "guard_requirements": [
    {
      "target_state": "TECHNICALLY_RELEVANT",
      "requires": [
        "source_ref",
        "observed_at_or_last_reviewed",
        "technical_fit.rationale"
      ],
      "denies": [
        "missing source lineage",
        "technical label without evidence"
      ]
    },
    {
      "target_state": "ORG_VERIFIED",
      "requires": [
        "organization_state == ORG_VERIFIED",
        "verified organization evidence"
      ],
      "denies": [
        "repository found only",
        "GitHub owner type User",
        "unverified org relation"
      ]
    },
    {
      "target_state": "ROLE_IDENTIFIED",
      "requires": [
        "target role class",
        "role-to-organization relation evidence"
      ],
      "denies": [
        "contributor treated as buyer",
        "person without verified role"
      ]
    },
    {
      "target_state": "QUALIFIED",
      "requires": [
        "buyer_problem_evidence",
        "relationship_hypothesis == BUYER_CANDIDATE or PARTNER_CANDIDATE",
        "freshness current or revalidated"
      ],
      "denies": [
        "technical relevance only",
        "competitor/peer only",
        "use-case signal only",
        "stale record"
      ]
    },
    {
      "target_state": "OUTREACH_READY",
      "requires": [
        "QUALIFIED state",
        "target role",
        "allowed claim set",
        "message draft",
        "Manuel human approval",
        "legal channel",
        "do_not_contact == false"
      ],
      "denies": [
        "missing target role",
        "unsupported public claim",
        "no human approval",
        "do_not_contact true"
      ]
    },
    {
      "target_state": "CONTACTED",
      "requires": [
        "OUTREACH_READY state",
        "message_ref_or_hash",
        "recipient_role",
        "sent_at",
        "channel",
        "approval_ref"
      ],
      "denies": [
        "contact before approval",
        "personal email from commit metadata"
      ]
    }
  ],
