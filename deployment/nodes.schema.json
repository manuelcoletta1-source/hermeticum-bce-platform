{
  "proto": "HBCE-NODE-MANIFEST-v1",
  "kind": "OPERATOR_NODE_MANIFEST",
  "network": "EU",
  "mode": "APPEND_ONLY",
  "issuer": "HERMETICUM B.C.E. S.r.l.",
  "policy": [
    "UE_FIRST",
    "AUDIT_FIRST",
    "FAIL_CLOSED",
    "HASH_ONLY",
    "APPEND_ONLY",
    "GDPR_MIN",
    "NO_PUBLIC_DATA_CUSTODY"
  ],

  "node": {
    "country": "IT",
    "region": "PIEMONTE",
    "city": "TORINO",
    "status": "PLANNED",

    "node_hash": "HBCE-IT-PIEMONTE-TORINO-PLANNED-000X",
    "operator": "PENDING",

    "timestamp": "2026-02-17T00:00:00Z",

    "note": "Template manifest: compilare e sostituire PENDING/000X."
  },

  "requirements": {
    "ipr_required": true,
    "license_required": true,
    "min_requirement": "1 VALID OPERATOR",
    "verification": "HASH_MATCH && OPERATOR_VALID",
    "failure_mode": "FAIL_CLOSED"
  },

  "operator_payload": {
    "operator_ipr_payload_sha256": "PUT_OPERATOR_IPR_SHA256_HERE",
    "operator_license_id": "PUT_LICENSE_ID_HERE",
    "operator_public_name": "PUT_PUBLIC_OPERATOR_LABEL_HERE"
  },

  "registry_snippet": {
    "target": "/deployment/nodes.json",
    "write_mode": "MANUAL_APPEND_ONLY",
    "insert_into": "nodes[]",
    "node_entry": {
      "region": "PIEMONTE",
      "country": "IT",
      "city": "TORINO",
      "status": "PLANNED",
      "node_hash": "HBCE-IT-PIEMONTE-TORINO-PLANNED-000X",
      "operator": "PENDING",
      "timestamp": "2026-02-17T00:00:00Z",
      "note": "From HBCE-NODE-MANIFEST-v1"
    }
  },

  "rules_for_activation": {
    "to_set_status_ACTIVE": [
      "operator_ipr_payload_sha256 present AND verified (VALID)",
      "operator field must NOT be PENDING",
      "node_hash must start with HBCE- or ORIGIN- and must NOT be PENDING",
      "timestamp must be ISO-8601",
      "if country == IT then region is required"
    ],
    "active_node_hash_prefix": ["HBCE-", "ORIGIN-"],
    "allowed_status": ["ACTIVE", "PILOT", "PLANNED"],
    "node_hash_charset": "A-Z 0-9 _ -",
    "node_hash_length": "10..80"
  },

  "contacts": {
