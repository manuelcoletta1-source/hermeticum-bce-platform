  "verification": {
    "proto": "HBCE-VERIFY-v1",
    "deterministic_result": [
      "VALID",
      "INVALID"
    ],
    "fail_closed_default": true,
    "rules": [
      "If any required field is missing, return INVALID.",
      "If payload_sha256 or event_payload_sha256 is not 64-hex, return INVALID.",
      "If the signature cannot be verified over canonical record bytes, return INVALID.",
      "If a record is derived and parent status is not VALID at the relevant timestamp, return INVALID.",
      "If record status is REVOKED, return INVALID.",
      "If record status is DRAFT or RND_ONLY, do not treat it as a production-valid operational authorization.",
      "Events are valid only if the operator signature verifies and the referenced entity exists with status VALID at or before the event timestamp.",
      "Example records containing placeholder keys or placeholder signatures must be treated as INVALID by a real verifier."
    ],
    "recommended_checks": [
      "Monotonic timeline per entity_id using non-decreasing timestamps.",
      "Optional anchor verification if ipfs, btc, or evm anchors are present.",
      "Operator key rotation and revocation policy.",
      "Explicit separation between public hash-only registry records and private or confidential payload storage.",
      "Independent security, legal, and compliance review before production deployment."
    ]
  },
