  "canonicalization": {
    "name": "HBCE_CANON_JSON_v1",
    "purpose": "Deterministic serialization before hashing and signing.",
    "rules": [
      "Encode as UTF-8.",
      "Sort object keys lexicographically by byte order.",
      "Use no insignificant whitespace.",
      "Arrays keep original order.",
      "Numbers must be JSON number type, not strings.",
      "Do not include transient fields not defined by the schema.",
      "Compute signatures over the canonical JSON bytes of the record object without the signature field itself.",
      "Public records must not embed personal data or confidential payload content when a hash-only reference is sufficient."
    ],
    "signature_exclusion_paths": [
      "$.issuer.signature",
      "$.operator.signature",
      "$.record_signature.signature"
    ]
  },
