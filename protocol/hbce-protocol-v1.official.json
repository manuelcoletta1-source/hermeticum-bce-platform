{
  "proto": "HBCE-PROTOCOL-v1",
  "kind": "OFFICIAL_PROTOCOL_BUNDLE",
  "issuer": "HERMETICUM B.C.E. S.r.l.",
  "jurisdiction": "EU",
  "mode": "PERMISSIONLESS",
  "policy": [
    "UE_FIRST",
    "AUDIT_FIRST",
    "FAIL_CLOSED",
    "HASH_ONLY",
    "APPEND_ONLY",
    "GDPR_MIN",
    "NO_PUBLIC_DATA_CUSTODY"
  ],
  "status": "OFFICIAL",
  "version": {
    "major": 1,
    "minor": 0,
    "patch": 0,
    "tag": "official"
  },

  "normative": {
    "timestamp_format": "RFC3339",
    "hash_algorithms": ["SHA-256", "SHA-512"],
    "signature_algorithms": ["ED25519"],
    "public_registry_exposure": "HASH_ONLY",
    "ledger_rules": {
      "append_only": true,
      "fail_closed": true,
      "inherit_invalidity": true
    }
  },

  "canonicalization": {
    "name": "HBCE_CANON_JSON_v1",
    "purpose": "Deterministic serialization before hashing/signing",
    "rules": [
      "Encode as UTF-8",
      "Sort object keys lexicographically (byte-order)",
      "No insignificant whitespace",
      "Arrays keep original order",
      "Numbers must be JSON number type (no strings)",
      "Do not include transient fields not defined by schema",
      "Signature is computed over the canonical JSON bytes of the record object WITHOUT the signature field itself"
    ],
    "signature_exclusion_paths": [
      "$.issuer.signature",
      "$.operator.signature"
    ]
  },

  "ids": {
    "entity_id": {
      "format": "string",
      "pattern_hint": "IPR-(ROOT|AI|INST|CORP|DEV)-[A-Z0-9\\-]{4,64}"
    },
    "operator_id": {
      "format": "string",
      "pattern_hint": "IPR-OP-[A-Z0-9\\-]{4,64}"
    },
    "event_id": {
      "format": "string",
      "pattern_hint": "EVT-[A-Z0-9\\-]{4,64}"
    }
  },

  "enums": {
    "entity_type": [
      "HUMAN_ROOT",
      "AI_ROOT",
      "INSTITUTION_ROOT",
      "CORPORATE_ROOT",
      "IPR_SOFTWARE",
      "IPR_ROBOT",
      "IPR_VEHICLE",
      "IPR_DRONE",
      "IPR_ENERGY",
      "IPR_SPACE",
      "IPR_INFRASTRUCTURE"
    ],
    "record_kind": [
      "IPR_ROOT_RECORD",
      "IPR_DERIVED_RECORD",
      "IPR_OPERATOR_RECORD",
      "IPR_EVENT_RECORD"
    ],
    "status": ["VALID", "INVALID", "REVOKED"],
    "derivation_type": [
      "DERIVED_FROM_ROOT",
      "DERIVED_FROM_CORPORATE",
      "DERIVED_FROM_INSTITUTION",
      "DERIVED_FROM_OPERATOR"
    ],
    "event_type": [
      "ACTIVATION",
      "STATUS_UPDATE",
      "FIRMWARE_UPDATE",
      "SOFTWARE_UPDATE",
      "CRITICAL_OPERATION",
      "ACCESS_EVENT",
      "SECURITY_ALERT",
      "DECOMMISSION"
    ],
    "operator_level": ["EDU", "LOCAL", "REGIONAL", "NATIONAL", "EU", "ENTERPRISE", "GOV"],
    "operator_roles": ["ISSUER", "VALIDATOR", "AUDITOR", "ROOT_COORDINATOR"]
  },

  "schemas": {
    "common": {
      "sha256": {
        "type": "string",
        "constraints": {
          "len": 64,
          "charset": "hex-lower-or-upper-allowed",
          "note": "Implementation must treat hex case-insensitively"
        }
      },
      "timestamp": {
        "type": "string",
        "constraints": {
          "format": "RFC3339",
          "timezone_required": true
        }
      },
      "signature_block": {
        "type": "object",
        "required": ["name", "sign_alg", "pubkey", "signature"],
        "properties": {
          "name": { "type": "string" },
          "sign_alg": { "type": "string", "enum_ref": "signature_algorithms" },
          "pubkey": { "type": "string", "note": "hex or base64" },
          "signature": { "type": "string", "note": "hex or base64 over canonical record bytes" }
        }
      }
    },

    "records": {
      "IPR_ROOT_RECORD": {
        "type": "object",
        "required": ["proto", "kind", "entity_id", "entity_type", "payload_sha256", "timestamp", "status", "issuer"],
        "properties": {
          "proto": { "type": "string", "const": "HBCE-REGISTRY-v1" },
          "kind": { "type": "string", "const": "IPR_ROOT_RECORD" },
          "entity_id": { "type": "string" },
          "entity_type": { "type": "string", "enum_ref": "entity_type" },
          "payload_sha256": { "type": "string", "ref": "common.sha256" },
          "timestamp": { "type": "string", "ref": "common.timestamp" },
          "status": { "type": "string", "enum_ref": "status" },
          "issuer": { "type": "object", "ref": "common.signature_block" },
          "anchors": {
            "type": "object",
            "required": [],
            "properties": {
              "ipfs_cid": { "type": "string" },
              "btc_txid": { "type": "string" },
              "evm_tx": { "type": "string" }
            }
          }
        }
      },

      "IPR_DERIVED_RECORD": {
        "type": "object",
        "required": [
          "proto",
          "kind",
          "entity_id",
          "entity_type",
          "parent_entity_id",
          "derivation_type",
          "payload_sha256",
          "timestamp",
          "status",
          "rules",
          "issuer"
        ],
        "properties": {
          "proto": { "type": "string", "const": "HBCE-REGISTRY-v1" },
          "kind": { "type": "string", "const": "IPR_DERIVED_RECORD" },
          "entity_id": { "type": "string" },
          "entity_type": { "type": "string", "enum_ref": "entity_type" },
          "parent_entity_id": { "type": "string" },
          "derivation_type": { "type": "string", "enum_ref": "derivation_type" },
          "payload_sha256": { "type": "string", "ref": "common.sha256" },
          "timestamp": { "type": "string", "ref": "common.timestamp" },
          "status": { "type": "string", "enum_ref": "status" },
          "rules": {
            "type": "object",
            "required": ["fail_closed", "inherit_invalidity", "append_only"],
            "properties": {
              "fail_closed": { "type": "boolean", "const": true },
              "inherit_invalidity": { "type": "boolean", "const": true },
              "append_only": { "type": "boolean", "const": true }
            }
          },
          "issuer": { "type": "object", "ref": "common.signature_block" }
        }
      },

      "IPR_OPERATOR_RECORD": {
        "type": "object",
        "required": ["proto", "kind", "operator_id", "payload_sha256", "timestamp", "status", "issuer"],
        "properties": {
          "proto": { "type": "string", "const": "HBCE-REGISTRY-v1" },
          "kind": { "type": "string", "const": "IPR_OPERATOR_RECORD" },
          "operator_id": { "type": "string" },
          "payload_sha256": { "type": "string", "ref": "common.sha256" },
          "timestamp": { "type": "string", "ref": "common.timestamp" },
          "status": { "type": "string", "enum_ref": "status" },
          "issuer": { "type": "object", "ref": "common.signature_block" }
        }
      },

      "IPR_EVENT_RECORD": {
        "type": "object",
        "required": [
          "proto",
          "kind",
          "event_id",
          "entity_id",
          "event_type",
          "event_payload_sha256",
          "timestamp",
          "operator",
          "status",
          "append_only"
        ],
        "properties": {
          "proto": { "type": "string", "const": "HBCE-REGISTRY-v1" },
          "kind": { "type": "string", "const": "IPR_EVENT_RECORD" },
          "event_id": { "type": "string" },
          "entity_id": { "type": "string" },
          "event_type": { "type": "string", "enum_ref": "event_type" },
          "event_payload_sha256": { "type": "string", "ref": "common.sha256" },
          "timestamp": { "type": "string", "ref": "common.timestamp" },
          "operator": {
            "type": "object",
            "required": ["operator_id", "sign_alg", "pubkey", "signature"],
            "properties": {
              "operator_id": { "type": "string" },
              "sign_alg": { "type": "string", "enum_ref": "signature_algorithms" },
              "pubkey": { "type": "string" },
              "signature": { "type": "string" }
            }
          },
          "status": { "type": "string", "enum_ref": "status" },
          "append_only": { "type": "boolean", "const": true }
        }
      }
    }
  },

  "verification": {
    "proto": "HBCE-VERIFY-v1",
    "deterministic_result": ["VALID", "INVALID"],
    "rules": [
      "If any required field missing -> INVALID (fail-closed)",
      "If payload_sha256 is not 64-hex -> INVALID",
      "If signature invalid over canonical record bytes -> INVALID",
      "If record is DERIVED and parent status != VALID -> INVALID",
      "If record status is REVOKED -> INVALID",
      "Events are valid only if operator signature verifies and entity exists with status VALID at (or before) event timestamp"
    ],
    "recommended_checks": [
      "Monotonic timeline per entity_id (non-decreasing timestamps)",
      "Optional anchor verification if anchors present (ipfs/btc/evm)",
      "Key rotation policy for operator keys (out of scope v1)"
    ]
  },

  "examples": {
    "root_record_public": {
      "proto": "HBCE-REGISTRY-v1",
      "kind": "IPR_ROOT_RECORD",
      "entity_id": "IPR-ROOT-EXAMPLE-0001",
      "entity_type": "HUMAN_ROOT",
      "payload_sha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      "timestamp": "2026-02-19T12:00:00+01:00",
      "status": "VALID",
      "issuer": {
        "name": "HERMETICUM B.C.E. S.r.l.",
        "sign_alg": "ED25519",
        "pubkey": "PUBKEY_PLACEHOLDER",
        "signature": "SIGNATURE_PLACEHOLDER"
      },
      "anchors": {
        "ipfs_cid": "bafy...optional"
      }
    },

    "derived_robot_record_public": {
      "proto": "HBCE-REGISTRY-v1",
      "kind": "IPR_DERIVED_RECORD",
      "entity_id": "IPR-DEV-ROBOT-0001",
      "entity_type": "IPR_ROBOT",
      "parent_entity_id": "IPR-ROOT-EXAMPLE-0001",
      "derivation_type": "DERIVED_FROM_ROOT",
      "payload_sha256": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
      "timestamp": "2026-02-19T12:10:00+01:00",
      "status": "VALID",
      "rules": {
        "fail_closed": true,
        "inherit_invalidity": true,
        "append_only": true
      },
      "issuer": {
        "name": "HERMETICUM B.C.E. S.r.l.",
        "sign_alg": "ED25519",
        "pubkey": "PUBKEY_PLACEHOLDER",
        "signature": "SIGNATURE_PLACEHOLDER"
      }
    },

    "event_record_public": {
      "proto": "HBCE-REGISTRY-v1",
      "kind": "IPR_EVENT_RECORD",
      "event_id": "EVT-EXAMPLE-0001",
      "entity_id": "IPR-DEV-ROBOT-0001",
      "event_type": "FIRMWARE_UPDATE",
      "event_payload_sha256": "cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc",
      "timestamp": "2026-02-19T12:25:00+01:00",
      "operator": {
        "operator_id": "IPR-OP-REGION-0001",
        "sign_alg": "ED25519",
        "pubkey": "PUBKEY_PLACEHOLDER",
        "signature": "SIGNATURE_PLACEHOLDER"
      },
      "status": "VALID",
      "append_only": true
    },

    "verify_response": {
      "proto": "HBCE-VERIFY-v1",
      "query": { "entity_id": "IPR-DEV-ROBOT-0001" },
      "result": {
        "status": "VALID",
        "reason": "SHA256_OK && SIGNATURE_OK && PARENT_VALID"
      },
      "evidence": {
        "last_event_id": "EVT-EXAMPLE-0001",
        "last_event_payload_sha256": "cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc"
      }
    }
  }
}
