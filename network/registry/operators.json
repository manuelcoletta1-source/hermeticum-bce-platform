{
  "proto": "HBCE-REGISTRY-v1",
  "kind": "CERTIFIED_OPERATORS_REGISTRY",
  "policy": [
    "UE_FIRST",
    "AUDIT_FIRST",
    "FAIL_CLOSED",
    "HASH_ONLY",
    "APPEND_ONLY",
    "NO_PUBLIC_DATA_CUSTODY",
    "GDPR_MIN"
  ],
  "description": "Registro pubblico operatori certificati UE. Append-only. Hash-only. Nessuna custodia dati personali.",
  "schema": {
    "required": [
      "label",
      "country",
      "payload_sha256",
      "timestamp"
    ],
    "optional": [
      "region",
      "city",
      "role",
      "level",
      "issuer",
      "notes"
    ]
  },
  "entries": []
}
